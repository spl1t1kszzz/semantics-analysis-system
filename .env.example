# Скопируйте в .env и подставьте свой ключ.
# Файл .env подхватывается автоматически (python-dotenv).
# При наличии OPENAI_API_KEY используется он; без OPENAI_API_BASE — официальный API OpenAI.

OPENAI_API_KEY=sk-your-openai-key-here

# Опционально: другой endpoint (например, прокси или локальная модель).
# Если не задан и задан OPENAI_API_KEY — используется api.openai.com.
# OPENAI_API_BASE=https://api.openai.com/v1
